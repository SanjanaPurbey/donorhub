# DonorHub ML Service Configuration (Flask WSGI)
# Copy this file to .env and update values for your environment

# =============================================================================
# SECURITY (REQUIRED for production)
# =============================================================================

# API key for authenticating requests from DonorHub frontend
# Generate a secure random string (32+ characters recommended)
# Must match ML_SERVICE_API_KEY in donorhub/.env.local
# Example: openssl rand -base64 48
ML_API_KEY=your-secure-api-key-minimum-32-characters

# Comma-separated list of allowed origins for CORS
# Production: https://your-donorhub-domain.vercel.app
# Development: http://localhost:3000
ALLOWED_ORIGINS_STR=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# MODEL CONFIGURATION
# =============================================================================

# Path to the trained model file
# Local development: models/donor_ranker.joblib (relative)
# PythonAnywhere: /home/YOUR_USERNAME/donorhub-ml-services/models/donor_ranker.joblib (absolute)
ML_MODEL_PATH=models/donor_ranker.joblib

# Model version string (for tracking/logging in API responses)
ML_MODEL_VERSION=v1.2.0

# =============================================================================
# SERVICE CONFIGURATION
# =============================================================================

# Service version (shown in health endpoint)
SERVICE_VERSION=1.0.0

# Enable debug mode
# - true: Skips API key validation (for local development)
# - false: Enforces API key validation (REQUIRED for production)
DEBUG=true
